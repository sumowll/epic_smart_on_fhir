APP_LEGAL_NAME=replace-with-your-legal-entity-name
APP_LEGAL_CONTACT_EMAIL=privacy-contact@example.invalid
APP_LEGAL_EFFECTIVE_DATE=2026-08-23
APP_HOSTING_PROVIDER_NAME=replace-with-your-hosting-provider-name

EPIC_CLIENT_ID=replace-with-your-non-production-client-id
EPIC_CLIENT_SECRET=replace-with-your-sandbox-client-secret
EPIC_TOKEN_AUTH_METHOD=client_secret_basic
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_PROVIDER_NAME=Epic R4 Sandbox
EPIC_REDIRECT_URI=http://localhost:3000/auth/callback
EPIC_SCOPES=openid fhirUser launch/patient
EPIC_ALLOWED_RESOURCE_SCOPES=patient/AllergyIntolerance.r patient/AllergyIntolerance.s patient/Binary.r patient/Binary.s patient/CarePlan.r patient/CarePlan.s patient/CareTeam.r patient/CareTeam.s patient/Condition.r patient/Condition.r?category=http://hl7.org/fhir/us/core/CodeSystem/condition-category|health-concern patient/Condition.r?category=http://terminology.hl7.org/CodeSystem/condition-category|problem-list-item patient/Condition.s patient/Condition.s?category=http://hl7.org/fhir/us/core/CodeSystem/condition-category|health-concern patient/Condition.s?category=http://terminology.hl7.org/CodeSystem/condition-category|problem-list-item patient/Device.r patient/Device.s patient/DiagnosticReport.r patient/DiagnosticReport.s patient/DocumentReference.r patient/DocumentReference.r?category=http://hl7.org/fhir/us/core/CodeSystem/us-core-documentreference-category|clinical-note patient/DocumentReference.s patient/DocumentReference.s?category=http://hl7.org/fhir/us/core/CodeSystem/us-core-documentreference-category|clinical-note patient/Encounter.r patient/Encounter.s patient/Goal.r patient/Goal.s patient/Immunization.r patient/Immunization.s patient/Location.r patient/Location.s patient/Medication.r patient/Medication.s patient/MedicationRequest.r patient/MedicationRequest.s patient/Observation.r?category=http://terminology.hl7.org/CodeSystem/observation-category|laboratory patient/Observation.r?category=http://terminology.hl7.org/CodeSystem/observation-category|social-history patient/Observation.r?category=http://terminology.hl7.org/CodeSystem/observation-category|vital-signs patient/Observation.s?category=http://terminology.hl7.org/CodeSystem/observation-category|laboratory patient/Observation.s?category=http://terminology.hl7.org/CodeSystem/observation-category|social-history patient/Observation.s?category=http://terminology.hl7.org/CodeSystem/observation-category|vital-signs patient/Organization.r patient/Organization.s patient/Patient.r patient/Patient.s patient/Practitioner.r patient/Practitioner.s patient/PractitionerRole.r patient/PractitionerRole.s patient/Procedure.r patient/Procedure.s patient/Provenance.r patient/RelatedPerson.r patient/RelatedPerson.s
EPIC_REQUEST_OFFLINE_ACCESS=false
EPIC_TRUSTED_ENDPOINT_ORIGINS=https://fhir.epic.com

SESSION_SECRET=replace-with-at-least-32-random-characters
CONSENT_POLICY_VERSION=2026-08-23
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=28800
HOST=127.0.0.1
PORT=3000

TOKEN_STORAGE=memory
TOKEN_STORE_FILE=.data/connections.enc
TOKEN_ENCRYPTION_KEY=

# Longitudinal FHIR storage and normalized intelligence are a separate, explicit
# opt-in capability. Keep its encryption and opaque-identity keys separate from
# token/session secrets. Bump the consent version for an approved purpose change;
# accepting that exact version authorizes backfill of still-retained raw versions.
FHIR_HUB_ENABLED=false
FHIR_HUB_STORE_FILE=.data/fhir-hub.enc
FHIR_HUB_ENCRYPTION_KEY=
FHIR_HUB_IDENTITY_KEY=
FHIR_HUB_CONSENT_VERSION=2026-08-26
FHIR_HUB_RETENTION_DAYS=365

EPIC_ALLOWED_RESOURCE_TYPES=AllergyIntolerance,Binary,CarePlan,CareTeam,Condition,Device,DiagnosticReport,DocumentReference,Encounter,Goal,Immunization,Location,Medication,MedicationRequest,Observation,Organization,Practitioner,PractitionerRole,Procedure,Provenance,RelatedPerson

# Used only with EPIC_TOKEN_AUTH_METHOD=private_key_jwt.
EPIC_PRIVATE_KEY_PATH=
EPIC_PRIVATE_KEY_PEM=
EPIC_PRIVATE_KEY_ALG=
EPIC_PRIVATE_KEY_KID=
