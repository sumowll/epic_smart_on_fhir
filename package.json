{
  "name": "epic-mychart-connector",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "description": "A secure patient-facing Epic MyChart SMART-on-FHIR connector",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cf-typegen": "wrangler types --include-env=false",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:epic": "node --env-file-if-exists=.env --import tsx src/check-epic.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "dev:worker": "wrangler dev",
    "deploy": "node -e \"console.error('Direct deployment is disabled. Follow docs/production-operations.md and use an approval-protected wrangler deploy --keep-vars --strict after staging validation.'); process.exit(1)\"",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "keys:generate": "node --import tsx src/generate-key.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens:purge": "node --env-file-if-exists=.env --import tsx src/purge-tokens.ts",
    "verify": "pnpm run check && pnpm test && pnpm run build && pnpm run deploy:dry-run"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/formbody": "^9.0.0",
    "fastify": "^5.6.2",
    "jose": "^6.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.126.0"
  }
}
