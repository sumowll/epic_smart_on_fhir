{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "epic-smart-on-fhir",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-22",
  "keep_vars": false,
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": false
    }
  },
  "limits": {
    "cpu_ms": 1000
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "10002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EPIC_CONNECTOR",
        "class_name": "EpicConnector"
      },
      {
        "name": "EPIC_CONNECTION_REGISTRY",
        "class_name": "EpicConnectionRegistry"
      },
      {
        "name": "EPIC_FHIR_HUB",
        "class_name": "EpicFhirHub"
      }
    ]
  },
  "exports": {
    "EpicConnector": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "EpicConnectionRegistry": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "EpicFhirHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
